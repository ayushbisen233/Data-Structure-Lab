#include <stdio.h>
#include <stdlib.h>

struct node {
    int vertex;
    struct node *next;
};

typedef struct node *GNODE;

GNODE graph[20];      // Adjacency list
int visited[20];      // Visited array

void DFS(int v) {
    GNODE temp;
    visited[v] = 1;
    printf("%d\n", v);
    temp = graph[v];
    while (temp != NULL) {
        if (!visited[temp->vertex]) {
            DFS(temp->vertex);
        }
        temp = temp->next;
    }
}

