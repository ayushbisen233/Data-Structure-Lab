};
typedef struct node* GNODE;
GNODE graph[MAX]; // Adjacency list
int visited[MAX]; // Visited array
int queue[MAX];   // Queue array
int front = -1, rear = -1;
void enqueue(int val) {
    if (rear == MAX - 1)
        return;
    if (front == -1)
        front = 0;
    queue[++rear] = val;
}
int dequeue() {
    if (front == -1 || front > rear)
        return -1;
    return queue[front++];
}
